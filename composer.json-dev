{
  "require": {
    "ackintosh/ganesha": "^1.0|^2.0|^3.0",
    "cebe/markdown": "^1.2.1",
    "doctrine/annotations": "^1.6",
    "doctrine/cache": "^1.5",
    "doctrine/orm": "^2.5",
    "ext-libxml": "*",
    "ext-sockets": "*",
    "ext-json": "*",
    "ext-pdo": "*",
    "ezyang/htmlpurifier": "^4.10.0",
    "friendsofphp/consul-php-sdk": ">=5.0.0",
    "filp/whoops": "^2.3",
    "guzzlehttp/guzzle": "^7.10.0",
    "inhere/php-validate": "^2.8",
    "illuminate/view": ">=9.0",
    "jakubledl/dissect": "~1.0",
    "malkusch/lock": "^3.0",
    "monolog/monolog": "^1.24",
    "nikic/php-parser": "^5.7.0",
    "opis/closure": "^4.3",
    "php": "^7.4 || ^8.0",
    "php-amqplib/php-amqplib": "^3.7.0",
    "php-di/php-di": "^7.1.0",
    "psr/http-message": "^1.0",
    "swlib/saber": "^1.0",
    "symfony/console": "^6.0",
    "symfony/finder": "^6.0",
    "symfony/var-dumper": "*",
    "symfony/yaml": "^6.0.0"
  },
  "autoload": {
    "psr-4": {
      "Yew\\": "vendor/bearlord/yew-framework/src",
      "App\\": "src/"
    },
    "files": [
      "vendor/bearlord/yew-framework/src/Core/Common.php",
      "vendor/bearlord/yew-framework/src/Goaop/ParserReflection/bootstrap.php",
      "vendor/bearlord/yew-framework/src/Nikic/FastRoute/bootstrap.php"
    ]
  },
  "require-dev": {
    "swoole/ide-helper": "*"
  }
}
